# Copia este archivo como .env y rellena los valores. .env NUNCA se sube al repositorio.

# The Guardian Open Platform: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Podcast Index (registro gratuito): https://api.podcastindex.org
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Wikimedia exige un User-Agent identificativo con contacto
WIKIMEDIA_USER_AGENT=SIMD-GenderAuditor/0.1 (UCLM I3A; tu_correo@uclm.es)

# Carpeta efímera para multimedia descargada (en Docker se monta como tmpfs)
MEDIA_DIR=/tmp/ramdisk

# Modelos del reranker (se pueden cambiar por otros más ligeros para pruebas)
RERANK_EMBED_MODEL=BAAI/bge-m3
RERANK_CROSS_MODEL=BAAI/bge-reranker-v2-m3
